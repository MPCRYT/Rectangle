class Rectangle:
  def __init__(self, width, height):
    self.width = width
    self.height = height

  def area(self):
    return self.height *  self.width

  def perimeter(self):
    return 2*(self.height + self.width)

  def display(self)
    i = 0
    while i  < self.height:
      print("*" * self.width)
      i += 1



    
